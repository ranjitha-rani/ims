# Copy to .env.oci, replace every CHANGE_ME value, and use:
# docker compose --env-file .env.oci -f compose.oci.yaml up -d
DATA_ROOT=/opt/ims/data

# Use an sslip.io name resolving to the instance public IP, for example
# ims.203-0-113-10.sslip.io. Ports 80/443 must reach this host for ACME TLS.
SSLIP_HOSTNAME=CHANGE_ME.sslip.io
CORS_ALLOWED_ORIGINS=https://ranjitha-rani.github.io

POSTGRES_DB=ims
POSTGRES_USER=ims
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# At least 32 random bytes. Do not reuse the database or Grafana password.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Optional first-run application administrator. Leave blank after bootstrap.
IMS_BOOTSTRAP_ADMIN_EMAIL=
IMS_BOOTSTRAP_ADMIN_PASSWORD=
IMS_BOOTSTRAP_ADMIN_NAME=IMS Administrator
IMS_DEMO_ENABLED=true
IMS_DEMO_CUSTOMER_PASSWORD=CHANGE_ME_DEMO_CUSTOMER_PASSWORD

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_GRAFANA_PASSWORD

BACKUP_RETENTION_DAYS=7
# Set after terraform apply using the oci_backup_uri and backup_bucket_namespace outputs.
# Example: oci://ims-backups/postgres
OCI_BACKUP_URI=
OCI_NAMESPACE=
# Use instance principal on the OCI VM; leave unset for local testing with API keys.
OCI_CLI_AUTH=instance_principal
